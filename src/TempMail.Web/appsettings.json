{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "TempMail": {
    "Domains": [
      "mail.example.com"
    ],
    "MailboxLifetimeHours": 24,
    "MessageLifetimeHours": 24,
    "AllowCustomAddress": true,
    "AllowMailboxExtension": true,
    "MaxMailboxLifetimeHours": 72,
    "StoragePath": "D:\\TempMailStorage",
    "DataProtectionPath": "D:\\TempMailKeys",
    "DataProtectionCertificateThumbprint": null,
    "MaxMessagesPerMailbox": 100,
    "MaxMailboxesPerIp": 10,
    "MaxStorageMB": 10240,
    "CleanupIntervalSeconds": 60,
    "CreateRequestsPerMinute": 10,
    "DeleteRequestsPerMinute": 20,
    "ReadRequestsPerMinute": 120,
    "ReservedNames": [
      "admin",
      "administrator",
      "root",
      "postmaster",
      "abuse",
      "support",
      "webmaster",
      "hostmaster"
    ]
  },
  "Smtp": {
    "Host": "0.0.0.0",
    "Port": 25,
    "MaxMessageSizeMB": 20,
    "MaxAttachmentSizeMB": 10,
    "MaxRecipients": 10,
    "RejectUnknownMailbox": true,
    "MaxConnections": 100,
    "MaxConnectionsPerIp": 5,
    "MessagesPerMinutePerIp": 30,
    "CommandTimeoutSeconds": 60,
    "ConnectionLifetimeSeconds": 300,
    "MaxConcurrentMessages": 4
  },
  "AllowedHosts": "localhost",
  "Security": {
    "IpHashKey": ""
  },
  "Logging": {
    "FilePath": "logs/web-.log"
  }
}
